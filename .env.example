# Example environment file for AutoGen Studio
# Copy this file to .env and replace the placeholder values with your actual API keys.

# Required (if using default OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Optional Configurations ---
# Uncomment the following lines if you want to use other model providers:

# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
